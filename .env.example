# ─────────────────────────────────────────────────────────────────────────────
# Ledgerline environment variables
# Copy to .env.local (never commit .env.local) and fill in values.
# Every variable is optional: without them the app runs fully in manual mode.
# All of these are read on the server only and never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Finnhub API key (free tier: https://finnhub.io/register).
# Powers real-time quotes, symbol search, company profiles, basic metrics and news.
# Free tier: ~60 calls/minute, personal/non-commercial use — see DATA_SOURCES.md.
FINNHUB_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email.
# Format: "<Company or app name> <contact email>"
# Example: SEC_USER_AGENT="Ledgerline Research ops@yourfirm.com"
SEC_USER_AGENT=

# Provider selection per capability (swap to a paid adapter without code changes
# elsewhere). Allowed values are documented in lib/data/registry.ts.
QUOTE_PROVIDER=finnhub
FUNDAMENTALS_PROVIDER=sec
RATES_PROVIDER=treasury
